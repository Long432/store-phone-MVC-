@model List<DienThoaiWeb.Models.CartItem>
@{
    ViewData["Title"] = "Tiến Hành Thanh Toán";
}
<div style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">
    <h1 style="font-size: 28px; font-weight: 800; color: #111; margin-bottom: 30px;">Thanh Toán Đơn Hàng</h1>
    
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px;">
        <!-- Cột Form Nhập Liệu -->
        <div style="background: white; border-radius: 12px; padding: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #eaeaea;">
            <h3 style="font-size: 18px; font-weight: 700; color: #005bbb; margin-bottom: 20px; border-bottom: 2px solid #f1f1f1; padding-bottom: 10px;">Thông tin giao hàng</h3>
            <form action="/GioHang/XacNhanThanhToan" method="post">
                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 10px;">Họ và tên người nhận <span style="color:red">*</span></label>
                    <input type="text" name="hoTen" required placeholder="Ví dụ: Nguyễn Văn A" style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; outline: none; box-sizing: border-box;">
                </div>
                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 10px;">Số điện thoại <span style="color:red">*</span></label>
                    <input type="text" name="sdt" required placeholder="Ví dụ: 0912345678" style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; outline: none; box-sizing: border-box;">
                </div>
                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 10px;">Địa chỉ nhận hàng (Chi tiết) <span style="color:red">*</span></label>
                    <input type="text" name="diaChi" required placeholder="Số nhà, Đường, Quận/Huyện, Tỉnh/TP" style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; outline: none; box-sizing: border-box;">
                </div>
                <div style="margin-bottom: 25px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 10px;">Ghi chú thêm</label>
                    <textarea name="ghiChu" rows="3" placeholder="Giao giờ hành chính, gọi trước khi giao..." style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #ccc; font-size: 14px; outline: none; box-sizing: border-box;"></textarea>
                </div>
                <button type="submit" style="background: linear-gradient(135deg, #005bbb, #001f3f); color: white; padding: 15px; width: 100%; border: none; border-radius: 8px; font-weight: 800; font-size: 16px; cursor: pointer; transition: transform 0.2s;">XÁC NHẬN MUA HÀNG</button>
            </form>
        </div>

        <!-- Cột Tóm tắt -->
        <div style="background: #f8f9fa; border-radius: 12px; padding: 30px; border: 1px solid #eaeaea; align-self: start;">
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 20px; border-bottom: 2px solid #eaeaea; padding-bottom: 10px;">Đơn hàng (@Model.Sum(x=>x.SoLuong) sản phẩm)</h3>
            
            <div style="max-height: 350px; overflow-y: auto; margin-bottom: 20px;">
                @foreach(var item in Model)
                {
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <img src="@item.HinhAnh" style="width: 50px; height: 50px; border-radius: 8px; object-fit: contain; background: white; border: 1px solid #eaeaea;">
                            <div>
                                <p style="font-weight: 700; font-size: 14px; margin-bottom: 3px; max-width: 140px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.TenSP</p>
                                <p style="font-size: 13px; color: #666;">SL: @item.SoLuong</p>
                            </div>
                        </div>
                        <span style="font-weight: 700; color: #333; font-size: 14px;">@item.ThanhTien.ToString("N0") ₫</span>
                    </div>
                }
            </div>

            <div style="border-top: 1px dashed #ccc; padding-top: 20px; margin-bottom: 15px; display: flex; justify-content: space-between;">
                <span style="color: #666; font-size: 15px;">Tạm tính:</span>
                <span style="font-weight: 600; font-size: 15px;">@Model.Sum(x=>x.ThanhTien).ToString("N0") ₫</span>
            </div>
            <div style="margin-bottom: 20px; display: flex; justify-content: space-between;">
                <span style="color: #666; font-size: 15px;">Phí vận chuyển:</span>
                <span style="font-weight: 600; font-size: 15px; color: #2ed573;">Miễn phí</span>
            </div>

            <div style="border-top: 2px solid #ccc; padding-top: 20px; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 700; font-size: 18px; color: #111;">TỔNG CỘNG</span>
                <span style="font-weight: 800; font-size: 22px; color: #e50027;">@Model.Sum(x=>x.ThanhTien).ToString("N0") ₫</span>
            </div>
        </div>
    </div>
</div>
