@{
    ViewData["Title"] = "Giới Thiệu";
}
<div style="max-width: 1000px; margin: 40px auto; padding: 0 20px;">
    <div style="background: linear-gradient(135deg, #005bbb, #05142a); border-radius: 16px; padding: 60px 40px; text-align: center; color: white; margin-bottom: 40px; box-shadow: 0 10px 30px rgba(0,91,187,0.2);">
        <h1 style="font-size: 36px; font-weight: 800; margin-bottom: 20px;">Về LDD Phone Store</h1>
        <p style="font-size: 18px; opacity: 0.9; max-width: 600px; margin: 0 auto; line-height: 1.6;">Khởi nguồn từ tận đáy đam mê công nghệ, chúng tôi cam kết mang tới cho khách hàng những sản phẩm đỉnh cao cùng dịch vụ tốt nhất Việt Nam.</p>
    </div>
    
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; margin-bottom: 50px;">
        <div>
            <h2 style="font-size: 28px; font-weight: 800; color: #222; margin-bottom: 20px;">Sứ mệnh của chúng tôi</h2>
            <p style="font-size: 16px; color: #555; line-height: 1.8; margin-bottom: 15px;">Không chỉ bán một chiếc điện thoại, chúng tôi trao gửi sự kết nối. Cửa hàng LDD Phone Store ra đời nhằm rút ngắn khoảng cách giữa tín đồ công nghệ và những sản phẩm toàn cầu.</p>
            <p style="font-size: 16px; color: #555; line-height: 1.8;">Mọi quy trình từ nhập hàng, kiểm định đến hậu mãi đều được chúng tôi tiêu chuẩn hóa nghiêm ngặt 100%.</p>
        </div>
        <img src="https://placehold.co/500x350/e1e5eb/555?text=Our+Mission" style="width: 100%; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,0.05);" />
    </div>
</div>
