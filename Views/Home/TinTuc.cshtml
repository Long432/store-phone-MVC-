@{
    ViewData["Title"] = "Tin Tức Công Nghệ";
}
<div style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">
    <h1 style="font-size: 32px; font-weight: 800; color: #111; margin-bottom: 30px;">Tin tức mới nhất</h1>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
        <!-- Card 1 -->
        <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.3s; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
            <img src="https://placehold.co/600x350/e1e5eb/555?text=Apple+Event" style="width: 100%; height: 200px; object-fit: cover; display: block;" />
            <div style="padding: 20px;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 10px; color: #333;">Sự kiện Apple 2024: iPhone 16 lộ diện hứa hẹn đột phá AI</h3>
                <p style="font-size: 14px; color: #666; line-height: 1.6; margin-bottom: 15px;">Apple rục rịch chuẩn bị tung ra thế hệ Smartphone tiếp theo tích hợp phần mềm thông minh sâu từ lõi...</p>
                <span style="font-size: 12px; color: #999; font-weight: 600;">24 Tháng 07, 2024</span>
            </div>
        </div>
        <!-- Card 2 -->
        <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.3s; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
            <img src="https://placehold.co/600x350/005bbb/fff?text=Samsung+AI" style="width: 100%; height: 200px; object-fit: cover; display: block;" />
            <div style="padding: 20px;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 10px; color: #333;">Galaxy AI đã hỗ trợ tiếng Việt trên S24 Series</h3>
                <p style="font-size: 14px; color: #666; line-height: 1.6; margin-bottom: 15px;">Tính năng khoanh vùng tìm kiếm và dịch thoại trực tiếp cuối cùng đã có bản cập nhật ngôn ngữ địa phương...</p>
                <span style="font-size: 12px; color: #999; font-weight: 600;">22 Tháng 07, 2024</span>
            </div>
        </div>
        <!-- Card 3 -->
         <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.3s; cursor: pointer;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
            <img src="https://placehold.co/600x350/ff6b00/fff?text=Xiaomi+Fold" style="width: 100%; height: 200px; object-fit: cover; display: block;" />
            <div style="padding: 20px;">
                <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 10px; color: #333;">Rò rỉ thiết kế Xiaomi Mix Fold 4: Màn hình gập mỏng nhất</h3>
                <p style="font-size: 14px; color: #666; line-height: 1.6; margin-bottom: 15px;">Tin đồn cho thấy mẫu điện thoại gập flagship của Xiaomi sẽ vượt mặt các tên tuổi lớn về độ mỏng...</p>
                <span style="font-size: 12px; color: #999; font-weight: 600;">20 Tháng 07, 2024</span>
            </div>
        </div>
    </div>
</div>
