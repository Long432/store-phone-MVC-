@{
    ViewData["Title"] = "Tuyển Dụng";
}
<div style="max-width: 1000px; margin: 40px auto; padding: 0 20px;">
    <h1 style="font-size: 32px; font-weight: 800; color: #111; margin-bottom: 15px; text-align: center;">Về Chung Nhà Cùng LDD Store</h1>
    <p style="text-align: center; color: #666; margin-bottom: 40px; font-size: 16px;">Môi trường linh hoạt, đãi ngộ cực đỉnh. Khám phá các vị trí đang mở:</p>

    <div style="background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="background: #f8f9fa; border-bottom: 2px solid #eaeaea;">
                    <th style="padding: 20px; font-size: 14px; color: #555; text-transform: uppercase;">Vị trí</th>
                    <th style="padding: 20px; font-size: 14px; color: #555; text-transform: uppercase;">Số lượng</th>
                    <th style="padding: 20px; font-size: 14px; color: #555; text-transform: uppercase;">Mức lương</th>
                    <th style="padding: 20px; font-size: 14px; color: #555; text-transform: uppercase;">Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px solid #f1f1f1;">
                    <td style="padding: 20px; font-weight: 700; color: #333;">Nhân viên Tư vấn Bán hàng (Fulltime)</td>
                    <td style="padding: 20px; color: #666;">05</td>
                    <td style="padding: 20px; font-weight: 600; color: #005bbb;">8tr - 15tr + Thưởng</td>
                    <td style="padding: 20px;"><span style="background: #2ed573; color: white; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 5px;">Đang mở</span></td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f1f1;">
                    <td style="padding: 20px; font-weight: 700; color: #333;">Kỹ thuật viên Phần cứng</td>
                    <td style="padding: 20px; color: #666;">02</td>
                    <td style="padding: 20px; font-weight: 600; color: #005bbb;">12tr - 20tr + Thưởng</td>
                    <td style="padding: 20px;"><span style="background: #2ed573; color: white; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 5px;">Đang mở</span></td>
                </tr>
                <tr>
                    <td style="padding: 20px; font-weight: 700; color: #333;">Lập trình viên Web .NET Core</td>
                    <td style="padding: 20px; color: #666;">01</td>
                    <td style="padding: 20px; font-weight: 600; color: #005bbb;">Thỏa thuận</td>
                    <td style="padding: 20px;"><span style="background: #ff4757; color: white; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 5px;">Đã đủ</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
