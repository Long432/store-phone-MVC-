@{
    ViewData["Title"] = "Liên Hệ";
}
<div style="max-width: 1000px; margin: 50px auto; padding: 0 20px;">
    <h1 style="font-size: 32px; font-weight: 800; text-align: center; margin-bottom: 10px; color: #111;">Liên Hệ Với LDD Store</h1>
    <p style="text-align: center; color: #666; margin-bottom: 50px; font-size: 15px;">Chúng tôi luôn lắng nghe và phản hồi quý khách trong vòng 24h làm việc.</p>
    
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 50px;">
        <!-- Đia chi -->
        <div style="background: white; border-radius: 16px; padding: 40px; box-shadow: 0 8px 25px rgba(0,0,0,0.04); border: 1px solid #f1f4f8;">
            <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 25px; border-bottom: 2px solid #eaeaea; padding-bottom: 15px;">Thông tin cửa hàng</h3>
            <div style="margin-bottom: 20px; display: flex; gap: 15px; align-items: flex-start;">
                <i class="fa fa-map-marker" style="font-size: 24px; color: #005bbb; margin-top: 5px;"></i>
                <div>
                    <h4 style="font-weight: 700; margin-bottom: 5px; color: #222;">Trụ sở chính</h4>
                    <p style="color: #666; font-size: 14px; line-height: 1.6;">Số 123, Phố Công Nghệ, Quận AI<br>Thủ đô Hà Nội, Việt Nam.</p>
                </div>
            </div>
            <div style="margin-bottom: 20px; display: flex; gap: 15px; align-items: flex-start;">
                <i class="fa fa-phone" style="font-size: 24px; color: #005bbb; margin-top: 5px;"></i>
                <div>
                    <h4 style="font-weight: 700; margin-bottom: 5px; color: #222;">Hotline liên hệ</h4>
                    <p style="color: #666; font-size: 14px;">1234.567.899 (Tư vấn miễn phí)</p>
                </div>
            </div>
        </div>
        
        <!-- Form -->
        <div style="background: white; border-radius: 16px; padding: 40px; box-shadow: 0 8px 25px rgba(0,0,0,0.04); border: 1px solid #f1f4f8;">
            <h3 style="font-size: 20px; font-weight: 700; margin-bottom: 25px;">Gửi tin nhắn</h3>
            <form onsubmit="alert('Đã gửi thông tin! Chúng tôi sẽ liên hệ lại sớm nhất.'); return false;">
                <input type="text" placeholder="Họ và tên của bạn" required style="width: 100%; padding: 15px; margin-bottom: 20px; border-radius: 8px; border: 2px solid #e1e5eb; font-size: 14px; outline: none;" onfocus="this.style.borderColor='#005bbb'" onblur="this.style.borderColor='#e1e5eb'" />
                <input type="email" placeholder="Email nhận phản hồi" required style="width: 100%; padding: 15px; margin-bottom: 20px; border-radius: 8px; border: 2px solid #e1e5eb; font-size: 14px; outline: none;" onfocus="this.style.borderColor='#005bbb'" onblur="this.style.borderColor='#e1e5eb'" />
                <textarea rows="4" placeholder="Nội dung cần hỗ trợ..." required style="width: 100%; padding: 15px; margin-bottom: 20px; border-radius: 8px; border: 2px solid #e1e5eb; font-size: 14px; outline: none;" onfocus="this.style.borderColor='#005bbb'" onblur="this.style.borderColor='#e1e5eb'"></textarea>
                <button type="submit" style="width: 100%; background: #005bbb; color: white; font-weight: 700; padding: 15px; border-radius: 8px; border: none; cursor: pointer; transition: background 0.3s; font-size: 15px;" onmouseover="this.style.background='#004494'" onmouseout="this.style.background='#005bbb'">GỬI YÊU CẦU</button>
            </form>
        </div>
    </div>
</div>
