            </div>
        </div>
        <div>
            <h4 style="font-size: 17px; font-weight: 700; margin-bottom: 25px; color: #111;">Sản phẩm nổi bật</h4>
            <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 16px;">
                <li><a href="/?search=iPhone" style="color: #555; text-decoration: none; font-size: 15px; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#ff6b00'" onmouseout="this.style.color='#555'">iPhone 15 Series</a></li>
                <li><a href="/?search=Samsung" style="color: #555; text-decoration: none; font-size: 15px; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#ff6b00'" onmouseout="this.style.color='#555'">Samsung Z Fold & Flip</a></li>
                <li><a href="/?search=Xiaomi" style="color: #555; text-decoration: none; font-size: 15px; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#ff6b00'" onmouseout="this.style.color='#555'">Xiaomi Flagship</a></li>
                <li><a href="/?search=Oppo" style="color: #555; text-decoration: none; font-size: 15px; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#ff6b00'" onmouseout="this.style.color='#555'">Oppo Find Series</a></li>
            </ul>
        </div>
        <div>
            <h4 style="font-size: 17px; font-weight: 700; margin-bottom: 25px; color: #111;">Hỗ trợ & Hướng dẫn</h4>
            <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 16px;">
                <li><a href="/Home/BaoHanh" style="color: #555; text-decoration: none; font-size: 15px; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#ff6b00'" onmouseout="this.style.color='#555'">Chính sách bảo hành</a></li>
                <li><a href="/GioHang" style="color: #555; text-decoration: none; font-size: 15px; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#ff6b00'" onmouseout="this.style.color='#555'">Hướng dẫn mua hàng</a></li>
                <li><a href="/Home/LienHe" style="color: #555; text-decoration: none; font-size: 15px; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#ff6b00'" onmouseout="this.style.color='#555'">Liên hệ & Góp ý</a></li>
                <li><a href="/Home/ChinhSachDoiTra" style="color: #555; text-decoration: none; font-size: 15px; font-weight: 500; transition: color 0.2s;" onmouseover="this.style.color='#ff6b00'" onmouseout="this.style.color='#555'">Chính sách đổi trả</a></li>
            </ul>
        </div>
        <div>
            <h4 style="font-size: 17px; font-weight: 700; margin-bottom: 25px; color: #111;">Đăng ký nhận Ưu Đãi</h4>
            <p style="color: #666; font-size: 14px; margin-bottom: 15px;">Tham gia bản tin của chúng tôi để nhận voucher sớm nhất.</p>
            <div style="display: flex; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border-radius: 8px; overflow: hidden;">
                <input type="text" placeholder="Nhập email của bạn..." style="padding: 14px 18px; border: 1px solid #ddd; border-right: none; outline: none; width: 100%; font-size: 14px; background: #fff; color: #333; border-radius: 8px 0 0 8px;">
                <button style="background: #ff6b00; color: white; border: none; padding: 0 24px; font-weight: 700; cursor: pointer; transition: background 0.3s;" onmouseover="this.style.background='#e56000'" onmouseout="this.style.background='#ff6b00'">GỬI</button>
            </div>
            <div id="alert" style="display:none; position:fixed; bottom: 30px; right: 30px; padding: 16px 24px; border-radius: 12px; color: white; box-shadow: 0 10px 30px rgba(0,0,0,0.15); z-index: 9999; font-weight: 600; font-size: 15px;"></div>
        </div>
    </div>
    <div style="border-top: 1px solid #eaeaea; margin-top: 60px; padding: 30px 20px 10px; max-width: 1200px; margin-left: auto; margin-right: auto; display: flex; justify-content: space-between; align-items: center; color: #888; font-size: 14px; flex-wrap: wrap; gap: 15px;">
        <p style="margin: 0;">&copy; 2026 <strong>LDD Store</strong>. Được thiết kế với tâm huyết.</p>
        <div style="display: flex; gap: 20px;">
            <a href="#" style="color: #888; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#111'" onmouseout="this.style.color='#888'">Điều khoản</a>
            <a href="#" style="color: #888; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#111'" onmouseout="this.style.color='#888'">Bảo mật</a>
        </div>
    </div>
</footer>
	<div id="goto-top-page" onclick="gotoTop()" style="position: fixed; bottom: 30px; right: 30px; width: 44px; height: 44px; background: #fff; color: #111; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; cursor: pointer; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 1px solid #eaeaea; transition: all 0.3s; z-index: 900; opacity: 0; pointer-events: none;"><i class="fa fa-arrow-up"></i></div>
    <style>
        #goto-top-page:hover { background: #ff6b00; color: #fff; border-color: #ff6b00; transform: translateY(-3px); }
        #goto-top-page.show { opacity: 1; pointer-events: auto; }
    </style>
    
    <script>
    // Scroll to top visibility
    window.addEventListener('scroll', function() {
        var topBtn = document.getElementById('goto-top-page');
        if (window.scrollY > 300) { topBtn.classList.add('show'); }
        else { topBtn.classList.remove('show'); }
    });
    
    function themVaoGioHangMoi(maSp) {
        $.post('/GioHang/ThemVaoGioHang', { maSp: maSp }, function(res) {
            if(res.success) {
                $('.cart-number').text(res.totalCount);
                // Premium toast notification
                var alertBox = $('#alert');
                alertBox.html('<div style="display: flex; align-items: center; gap: 12px;"><div style="width: 28px; height: 28px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center;"><i class="fa fa-check"></i></div> Đã thêm vào giỏ hàng thành công!</div>');
                alertBox.css({'background': 'linear-gradient(135deg, #00c6ff, #0072ff)', 'color': 'white'});
                alertBox.fadeIn(300);
                setTimeout(function(){ alertBox.fadeOut(300); }, 3500);
            }
        });
    }

    // Modal UI logic
    function checkTaiKhoan() {
        $('.containTaikhoan').css('display', 'flex').hide().fadeIn(300);
    }
    function showTaiKhoan(show) {
        if(show) { $('.containTaikhoan').css('display', 'flex').hide().fadeIn(300); }
        else { $('.containTaikhoan').fadeOut(300); }
    }
    
    // Auth Tabs Transition
    $('.tab a').on('click', function (e) {
        e.preventDefault();
        $(this).parent().addClass('active');
        $(this).parent().siblings().removeClass('active');
        var target = $(this).attr('data-target');
        $('.tab-content > div').not('#' + target).fadeOut(150, function() {
            $('#' + target).fadeIn(200);
        });
    });
    
    // Close modal when clicking outside
    $('.containTaikhoan').click(function(e) {
        if($(e.target).is('.containTaikhoan')) {
            showTaiKhoan(false);
        }
    });
    </script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
